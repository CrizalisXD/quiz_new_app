<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#09D6C6"
                android:endColor="#4C7BEE"
                android:centerY="0.22"
                />
        </shape>
    </item>
    <!-- Если нужно добавить логотип по центру на самом раннем этапе, можно раскомментировать:
    <item>
        <bitmap android:gravity="center" android:src="@mipmap/ic_launcher"/>
    </item>
    -->
</layer-list>
